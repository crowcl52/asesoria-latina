---
import ServiceIcon from './ServiceIcon.astro';
import type { Messages } from '../i18n';

interface Props {
	messages: Messages;
}

const { messages } = Astro.props;
const s = messages.services;
---

<section id="services" class="border-b border-white/10 bg-page-bg py-16 md:py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-5" data-reveal>
		<p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-gold-muted">{s.sectionEyebrow}</p>
		<h2 class="mt-2 text-3xl font-bold md:text-4xl">{s.title}</h2>
		<p class="mt-4 max-w-2xl leading-relaxed text-stone-400">{s.subtitle}</p>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				s.items.map((item, i) => (
					<article class="flex gap-4 rounded-2xl border border-white/10 bg-surface-muted/80 p-6 shadow-sm transition hover:border-gold-muted/40 hover:shadow-md">
						<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-surface shadow-sm ring-1 ring-white/10">
							<ServiceIcon variant={i} />
						</div>
						<div>
							<h3 class="text-lg font-bold">{item.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-stone-400">{item.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
