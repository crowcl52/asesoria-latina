---
import type { Lang } from '../i18n';
import type { Messages } from '../i18n';

interface Props {
	lang: Lang;
	messages: Messages;
}

const { lang, messages } = Astro.props;
const f = messages.footer;
---

<footer
	class="[scroll-snap-align:none] border-t border-white/10 bg-black py-12 font-sans text-stone-400"
>
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 md:flex-row md:items-start md:justify-between">
		<div>
			<p class="font-serif text-xl font-bold text-gold">{messages.brand.name}</p>
			<p class="mt-2 max-w-sm text-sm text-stone-500">{messages.brand.tagline}</p>
			<p class="mt-6 text-xs text-stone-600">© {new Date().getFullYear()} {f.rights}</p>
		</div>
		<div class="flex flex-col gap-4 text-sm">
			<p class="font-semibold uppercase tracking-wide text-stone-400">Legal</p>
			<a class="hover:text-white" href={f.privacyHref}>{f.privacy}</a>
			<a class="hover:text-white" href={f.termsHref}>{f.terms}</a>
			<a class="hover:text-white" href={f.cookiesHref}>{f.cookies}</a>
		</div>
		<div class="flex flex-col gap-4 text-sm">
			<p class="font-semibold uppercase tracking-wide text-stone-400">
				{lang === 'es' ? 'Idioma' : 'Language'}
			</p>
			<div class="flex gap-3">
				<a class="rounded px-2 py-1 hover:bg-white/10" href="/es/">ES</a>
				<a class="rounded px-2 py-1 hover:bg-white/10" href="/en/">EN</a>
			</div>
			{(f.socialFacebook || f.socialInstagram) && (
				<div class="flex flex-wrap gap-3 pt-2">
					{f.socialFacebook && (
						<a class="hover:text-white" href={f.socialFacebook} rel="noopener noreferrer" target="_blank">
							{f.socialFacebookLabel}
						</a>
					)}
					{f.socialInstagram && (
						<a class="hover:text-white" href={f.socialInstagram} rel="noopener noreferrer" target="_blank">
							{f.socialInstagramLabel}
						</a>
					)}
				</div>
			)}
		</div>
	</div>
</footer>
