---
import type { Messages } from '../i18n';

interface Props {
	messages: Messages;
}

const { messages } = Astro.props;
const p = messages.pillars;
---

<section
	id="pillars"
	class="border-b border-white/10 bg-page-bg py-16 md:py-20"
>
	<div class="mx-auto max-w-6xl px-4 sm:px-5" data-reveal>
		<p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-gold-muted">{p.sectionEyebrow}</p>
		<h2 class="mt-2 text-3xl font-bold md:text-4xl">{p.title}</h2>

		<div class="mt-10 grid gap-8 lg:grid-cols-2">
			<div class="rounded-2xl border border-white/10 bg-surface-muted/90 p-8 shadow-sm">
				<h3 class="text-xl font-bold">{p.commitmentTitle}</h3>
				<p class="mt-4 leading-relaxed text-stone-400">{p.commitmentBody}</p>
			</div>
			<div>
				<h3 class="text-xl font-bold">{p.valuesTitle}</h3>
				<ul class="mt-6 grid gap-4 sm:grid-cols-2">
					{
						p.values.map((v) => (
							<li class="rounded-xl border border-white/10 bg-surface p-5 shadow-sm">
								<p class="font-serif font-bold text-gold-light">{v.title}</p>
								<p class="mt-2 text-sm leading-relaxed text-stone-400">{v.body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
