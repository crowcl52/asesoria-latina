---
import type { Messages } from '../i18n';

interface Props {
	messages: Messages;
}

const { messages } = Astro.props;
const t = messages.team;
const fallback = messages.images.teamFallback;
---

<section id="team" class="bg-surface py-16 md:py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-5" data-reveal>
		<p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-gold-muted">{t.sectionEyebrow}</p>
		<h2 class="mt-2 text-3xl font-bold md:text-4xl">{t.title}</h2>
		<p class="mt-4 max-w-2xl text-stone-400">{t.subtitle}</p>

		<div class="mt-12 grid gap-10 md:grid-cols-3">
			{
				t.members.map((m) => (
					<article class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-surface-muted shadow-sm">
						<div class="aspect-[3/4] w-full overflow-hidden bg-black md:aspect-[4/5]">
							<img
								src={m.image ?? fallback}
								alt={m.imageAlt}
								class="h-full w-full object-cover object-[center_20%]"
								loading="lazy"
								decoding="async"
								width={480}
								height={640}
							/>
						</div>
						<div class="flex flex-1 flex-col p-6">
							<h3 class="text-xl font-bold">{m.name}</h3>
							<p class="mt-1 font-sans text-xs font-semibold uppercase tracking-wide text-gold-muted">
								{m.role}
							</p>
							<p class="mt-4 flex-1 text-sm leading-relaxed text-stone-400">{m.bio}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
