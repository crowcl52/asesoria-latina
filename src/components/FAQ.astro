---
import type { Messages } from '../i18n';

interface Props {
	messages: Messages;
}

const { messages } = Astro.props;
const f = messages.faq;
---

<section id="faq" class="border-b border-white/10 bg-page-bg py-16 md:py-20">
	<div class="mx-auto max-w-3xl px-4 sm:px-5" data-reveal>
		<p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-gold-muted">{f.sectionEyebrow}</p>
		<h2 class="mt-2 text-3xl font-bold md:text-4xl">{f.title}</h2>

		<div class="mt-10 space-y-3">
			{
				f.items.map((item, i) => (
					<details class="group rounded-xl border border-white/10 bg-surface-muted/80 open:bg-surface open:shadow-md">
						<summary class="cursor-pointer list-none px-5 py-4 font-serif text-lg font-semibold text-gold marker:content-none [&::-webkit-details-marker]:hidden">
							<span class="flex items-start justify-between gap-3">
								<span>
									<span class="mr-2 font-sans text-sm font-normal text-stone-400">{i + 1}.</span>
									{item.question}
								</span>
								<svg
									class="mt-1 h-5 w-5 shrink-0 text-stone-400 transition group-open:rotate-180"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									aria-hidden="true"
								>
									<path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
								</svg>
							</span>
						</summary>
						<div class="border-t border-white/10 px-5 pb-4 pt-0">
							<p class="pt-3 leading-relaxed text-stone-400">{item.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>
