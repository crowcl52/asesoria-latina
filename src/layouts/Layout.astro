---
import '../styles/global.css';
import type { Lang } from '../i18n';
import type { Messages } from '../i18n';

interface Props {
	lang: Lang;
	messages: Messages;
}

const { lang, messages } = Astro.props;
const htmlLang = lang === 'es' ? 'es' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={messages.meta.description} />
		<link rel="icon" href="/favicon.ico" sizes="any" type="image/x-icon" />
		<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
		<link rel="apple-touch-icon" href={messages.brand.logo} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{messages.meta.title}</title>
		<noscript>
			<style>
				[data-reveal] {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class="min-h-screen">
		<slot />
		<script is:inline>
			(function () {
				function prefersReducedMotion() {
					return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				}

				function smoothScrollToHash(hash) {
					if (!hash || hash === '#') return false;
					var el = document.querySelector(hash);
					if (!el) return false;
					el.scrollIntoView({
						behavior: prefersReducedMotion() ? 'instant' : 'smooth',
						block: 'start',
					});
					return true;
				}

				function normalizePathname(path) {
					if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
					return path;
				}

				document.addEventListener(
					'click',
					function (e) {
						var a = e.target.closest && e.target.closest('a[href*="#"]');
						if (!a || a.target === '_blank' || a.getAttribute('download')) return;
						var hrefAttr = a.getAttribute('href');
						if (!hrefAttr || hrefAttr.startsWith('mailto:') || hrefAttr.startsWith('tel:')) return;
						var url;
						try {
							url = new URL(a.href, window.location.href);
						} catch (err) {
							return;
						}
						if (url.origin !== window.location.origin) return;
						if (normalizePathname(url.pathname) !== normalizePathname(window.location.pathname)) return;
						var hash = url.hash;
						if (!hash) return;
						var target = document.querySelector(hash);
						if (!target) return;
						e.preventDefault();
						smoothScrollToHash(hash);
						if (history.pushState) {
							history.pushState(null, '', url.pathname + url.search + hash);
						} else {
							window.location.hash = hash;
						}
					},
					true
				);

				function scrollHashOnLoad() {
					var hash = window.location.hash;
					if (!hash) return;
					requestAnimationFrame(function () {
						requestAnimationFrame(function () {
							smoothScrollToHash(hash);
						});
					});
				}

				function initReveal() {
					var nodes = document.querySelectorAll('[data-reveal]');
					if (!nodes.length) return;
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						nodes.forEach(function (n) {
							n.classList.add('is-visible');
						});
						return;
					}
					function inViewport(el) {
						var r = el.getBoundingClientRect();
						var vh = window.innerHeight || document.documentElement.clientHeight;
						return r.top < vh + 80 && r.bottom > -80;
					}
					var io = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (entry) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-visible');
									io.unobserve(entry.target);
								}
							});
						},
						{ rootMargin: '0px 0px 12% 0px', threshold: 0 }
					);
					nodes.forEach(function (n) {
						if (inViewport(n)) {
							n.classList.add('is-visible');
						} else {
							io.observe(n);
						}
					});
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', function () {
						initReveal();
						scrollHashOnLoad();
					});
				} else {
					initReveal();
					scrollHashOnLoad();
				}
			})();
		</script>
	</body>
</html>
